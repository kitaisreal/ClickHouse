<clickhouse>
    <storage_configuration>
        <disks>
            <s3>
                <type>s3</type>
                <endpoint>http://localhost:9023/test-bucket/data/</endpoint>
                <access_key_id>minioadmin</access_key_id>
                <secret_access_key>minioadmin</secret_access_key>
                <use_path_style_access>true</use_path_style_access>
                <persist_removal_queue>true</persist_removal_queue>
            </s3>
            <s3_cache>
                <type>cache</type>
                <disk>s3</disk>
                <path>/home/ubuntu/ClickHouse/build_release/programs/filesystem_caches/s3_cache/</path>
                <cache_on_write_operations>1</cache_on_write_operations>
                <max_size>50Gi</max_size>
            </s3_cache>
        </disks>
        <policies>
            <s3_main>
                <volumes>
                    <main>
                        <disk>s3_cache</disk>
                    </main>
                </volumes>
            </s3_main>
        </policies>
    </storage_configuration>
</clickhouse>
